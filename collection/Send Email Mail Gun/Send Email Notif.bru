meta {
  name: Send Email Notif
  type: http
  seq: 2
}

post {
  url: {{localhost}}/send-email
  body: multipartForm
  auth: none
}

body:multipart-form {
  to: francis.santander@viewqwest.com
  subject: Hello from Mailgun Sandbox
  text: This is a test 6 email using Mailgun + PHP
  ~issueKey: test issueKey
  ~summary: test summary
  ~status: test status
  ~comment: test comment
  ~reporter: test reporter
}
